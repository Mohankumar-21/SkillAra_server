# Server
PORT=5000
NODE_ENV=development

# MongoDB — get this from MongoDB Atlas → Connect → Drivers
# Example Atlas SRV:
# MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/skillara?retryWrites=true&w=majority
# Example local MongoDB:
# MONGO_URI=mongodb://127.0.0.1:27017/skillara
MONGO_URI=

# Multi-tenant
ROOT_DOMAIN=skillara.com

# Refresh-token cookie Domain (production only). Leave unset for localhost —
# setting this to .skillara.com locally prevents the browser from storing the
# session cookie, so "Remember me" / stay-signed-in will not work.
# COOKIE_DOMAIN=.skillara.com

# JWT — RS256 asymmetric keys (required in production)
# PEM strings; use \n for line breaks when storing in .env
# PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
# In development, keys are auto-generated under .keys/ if these are unset.

# Legacy HS256 secrets (deprecated — remove after auth migration to utils/tokens.js)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# CORS (comma-separated origins; *.localhost auto-allowed in development)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Super admin seed (created on first startup)
DEFAULT_SUPER_ADMIN_EMAIL=tech.skillara@gmail.com
DEFAULT_SUPER_ADMIN_PASSWORD=Abc@123

# Client app URL (used for invite signup links)
CLIENT_APP_URL=http://acme-bootcamp.localhost:5173
CLIENT_APP_PORT=5173
CLIENT_APP_PROTOCOL=https

# ---------------------------------------------------------------------------
# Backblaze B2 object storage (S3-compatible API) — all course media
# ---------------------------------------------------------------------------
# Create a bucket-scoped Application Key in the B2 console
# (App Keys → Add a New Application Key → restrict to this bucket).
# Do NOT use the account Master Application Key here: it grants full account
# access including key management and bucket deletion, and it cannot be scoped.
B2_ENDPOINT=s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_BUCKET=SkillAra
B2_KEY_ID=
B2_APP_KEY=

# Signed URL lifetimes in seconds. Playback URLs are deliberately short-lived so a
# copied link stops working quickly.
B2_DOWNLOAD_URL_TTL=900
B2_UPLOAD_URL_TTL=3600

# Upload size caps (MB). Video larger than MAX_PROXY_UPLOAD_MB must use the
# presigned direct-to-B2 flow rather than passing through this server.
MAX_IMAGE_UPLOAD_MB=5
MAX_DOCUMENT_UPLOAD_MB=25
MAX_PROXY_UPLOAD_MB=50

# ---------------------------------------------------------------------------
# Live video (mock interviews, mentorship, live class sessions)
# ---------------------------------------------------------------------------
# No third-party video API key needed. Peers connect over our own WebRTC
# signaling server (services/webrtcSignaling.js, exposed at /socket.io/webrtc)
# using Google's free public STUN servers below for NAT traversal. If a direct
# peer connection can't be established (e.g. both sides on strict/symmetric
# NATs) the client falls back to a public meet.jit.si room — also no key.
# For production reliability across all networks you'd add a TURN relay here
# later (e.g. coturn, self-hosted); none is configured by default.
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Email — Gmail SMTP (use an App Password, not your normal Gmail password)
# Google Account → Security → 2-Step Verification → App passwords
EMAIL_FROM=tech.skillara@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tech.skillara@gmail.com
SMTP_PASS=

# ---------------------------------------------------------------------------
# AI features (services/aiService.js) — AI tutor, quiz/mock-test generation,
# summarization, submission grading. Uses the OpenAI SDK, so it works with
# OpenAI directly or any OpenAI-compatible gateway (e.g. OpenRouter).
# ---------------------------------------------------------------------------
# OpenAI directly:
#   OPENAI_API_KEY=sk-...
#   (leave OPENAI_BASE_URL unset, AI_MODEL=gpt-4o)
# OpenRouter (model ids are provider-namespaced, e.g. "openai/gpt-4o"):
#   OPENAI_API_KEY=sk-or-v1-...
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   AI_MODEL=openai/gpt-4o
OPENAI_API_KEY=
OPENAI_BASE_URL=
AI_MODEL=gpt-4o
# Caps completion length — the SDK defaults to 16384 if unset, which a free/low-balance
# OpenRouter account usually can't afford. Lower further if you still hit 402s.
AI_MAX_TOKENS=2000
