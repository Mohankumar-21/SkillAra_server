# Server
PORT=5000
NODE_ENV=development

# MongoDB — get this from MongoDB Atlas → Connect → Drivers
# Example Atlas SRV:
# MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/skillara?retryWrites=true&w=majority
# Example local MongoDB:
# MONGO_URI=mongodb://127.0.0.1:27017/skillara
MONGO_URI=

# Multi-tenant
ROOT_DOMAIN=skillara.com

# JWT — RS256 asymmetric keys (required in production)
# PEM strings; use \n for line breaks when storing in .env
# PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
# In development, keys are auto-generated under .keys/ if these are unset.

# Legacy HS256 secrets (deprecated — remove after auth migration to utils/tokens.js)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# CORS (comma-separated origins; *.localhost auto-allowed in development)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Super admin seed (created on first startup)
DEFAULT_SUPER_ADMIN_EMAIL=tech.skillara@gmail.com
DEFAULT_SUPER_ADMIN_PASSWORD=Abc@123

# Client app URL (used for invite signup links)
CLIENT_APP_URL=http://acme.localhost:5173
CLIENT_APP_PORT=5173
CLIENT_APP_PROTOCOL=https

# Email — Gmail SMTP (use an App Password, not your normal Gmail password)
# Google Account → Security → 2-Step Verification → App passwords
EMAIL_FROM=tech.skillara@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tech.skillara@gmail.com
SMTP_PASS=
